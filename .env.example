# ========================================
# ARQUIVO .ENV - EXEMPLO
# ========================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA faça commit do arquivo .env (já está no .gitignore)

# ========================================
# BANCO DE DADOS NEON (PostgreSQL)
# ========================================
# Formato: postgresql://usuario:senha@host:porta/database?sslmode=require
# Exemplo: postgresql://usuario:senha123@ep-cool-meadow-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://seu_usuario:sua_senha@seu-host.neon.tech/seu_database?sslmode=require

# ========================================
# ZOHO PROJECTS API
# ========================================
# Obtenha em: https://api-console.zoho.com/
ZOHO_CLIENT_ID=seu_client_id_aqui
ZOHO_CLIENT_SECRET=seu_client_secret_aqui
ZOHO_REFRESH_TOKEN=seu_refresh_token_aqui

# ========================================
# FLASK
# ========================================
# Gere uma chave aleatória segura:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua_chave_secreta_aleatoria_aqui

# ========================================
# TOKEN DE SINCRONIZAÇÃO
# ========================================
# Usado para autenticar o endpoint /api/trigger-sync
# Gere um token seguro:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=seu_token_de_sincronizacao_aqui

# ========================================
# OPCIONAL - CONFIGURAÇÕES ADICIONAIS
# ========================================
# FLASK_ENV=development
# FLASK_DEBUG=True
